///- --package .
open sm'_operators

test showcase static =
    open testing

inl article () : page.entry =
    {
        slug = "showcase"
        title = "Every Block, Once"
        date = "2026-10-18"
        kind = page.Article
        authors = [{ name = "i574n"; handle = "i574n" }]
        blurb = "A sample post that renders every block the blog engine has."
        blocks =
            [
                post.Paragraph "This post exercises the engine: every block kind appears at least once, and a test fails when one is missing."
                post.Heading "Text"
                post.Paragraph "Paragraphs escape their text, so <tags> & ampersands print as written."
                post.Note "A note renders as an aside."
                post.Heading "Code"
                post.Code ("spiral", "inl twice f x = f (f x)\ntwice ((+) 1i32) 40i32")
                post.Terminal ("pwsh scripts/build.ps1", "BLOG-OK blog/engine")
                post.Heading "Data"
                post.Table (
                    ["Block"; "Renders as"],
                    [
                        ["Heading"; "an h2 with a section anchor and a table of contents entry"]
                        ["Table"; "a table with a head row and escaped cells"]
                    ])
                post.Rule
                post.Heading "Conclusion"
                post.Paragraph "Real posts live in the repositories they describe; this one only shows the machinery."
            ]
    }

inl release () : page.entry =
    inl a = article ()
    { a with slug = "showcase-release"; title = "Engine Release Notes"; kind = page.Release; blurb = "A sample release entry, so the Releases tab has content."; blocks = [post.Paragraph "Release entries share the article layout and get a Release label in the index."] }

inl entries () : list page.entry = [article (); release ()]

inl block_tag (b : post.block) : string =
    match b with
    | post.Heading _ => "heading"
    | post.Paragraph _ => "paragraph"
    | post.Code _ => "code"
    | post.Terminal _ => "terminal"
    | post.Table _ => "table"
    | post.Note _ => "note"
    | post.Rule => "rule"

inl rec tags (blocks : list post.block) : string =
    match blocks with
    | Nil => ""
    | Cons (b, rest) => " " ++# block_tag b ++# tags rest

inl rec all_present (present : string) (wanted : list string) : bool =
    match wanted with
    | Nil => true
    | Cons (t, rest) => (present |> sm'.contains (" " ++# t)) && all_present present rest

test every_block_kind_appears =
    inl a = article ()
    all_present (tags a.blocks) ["heading"; "paragraph"; "code"; "terminal"; "table"; "note"; "rule"] |> _assert_eq true

test the_release_entry_is_labeled =
    inl r = release ()
    page.kind_label r.kind |> _assert_eq "Release"

test the_showcase_renders_into_the_site =
    entries () |> site.files |> site.paths |> _assert_eq "index.html style.css rss.xml articles/index.html releases/index.html showcase/index.html showcase-release/index.html"
