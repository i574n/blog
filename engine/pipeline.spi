///- --package .
open sm'_operators

test pipeline static =
    open testing

inl entry () : page.entry =
    {
        slug = "pipeline"
        title = "Behind the Scenes of Spiral"
        date = "2026-10-18"
        kind = page.Article
        authors = [{ name = "i574n"; handle = "i574n" }]
        blurb = "How a .spi file becomes code for 19 backends, and how we know every one of them gives the same answer."
        blocks =
            [
                post.Paragraph "Spiral is a functional language whose compiler evaluates your program as far as it can at compile time and emits what is left, the residual, in a target language."
                post.Paragraph "This post follows one program from its source file to a blessed result on every backend."
                post.Heading "One file, two cores"
                post.Paragraph "The compiler is a single F# file of about 186,000 lines. It holds two evaluators: single-flight, the sequential one that ships, and gpt5parallel, a parallel rewrite on Hopac that must reproduce it."
                post.Paragraph "Code both cores share appears once. A section that differs appears twice, inside #if pairs, and a gate stops the build when a pair changes on one side only."
                post.Note "hopacsota, a third mode, restarts the parallel work from single-flight's evaluator as a thin layer of seams."
                post.Heading "Nineteen targets"
                post.Paragraph "From the same residual the compiler writes F#, C, Rust, Delphi, Zig, TypeScript, Lua, Gleam, Python, C++, WebAssembly, WGSL, Calyx, Kotlin, Swift, OpenQASM, eBPF, Lean and Bend."
                post.Table (
                    ["Backend"; "Rows"; "Agree with C"],
                    [
                        ["Zig"; "460"; "all"]
                        ["Kotlin"; "452"; "all"]
                        ["Lua"; "448"; "all"]
                    ])
                post.Heading "C is the oracle"
                post.Paragraph "Every sample runs natively on each backend it lists. C's exit code and stdout are the oracle, and Zig is a second one: a row that disagrees with either is a bug until a matrix entry explains it."
                post.Terminal ("pwsh test.ps1 -Suite all -Native", "native: 5941 ran, 8 build-fail, oracle agree 5436, DISAGREE 0")
                post.Heading "Packs and blesses"
                post.Paragraph "Changes travel in packs: build every core, run the full suite against the last bless, explain every changed row, then bless. The bless run must reproduce the review row for row."
                post.Paragraph "Compile and native results are memoized by content, so a suite whose inputs did not change replays in about a minute, and only rows whose output bytes changed run again."
                post.Rule
                post.Heading "Conclusion"
                post.Paragraph "One evaluator, many printers, and one oracle that says whether they agree. Try it on your own program."
            ]
    }

test the_first_post_is_an_article_named_pipeline =
    inl e = entry ()
    e.slug ++# " " ++# page.kind_label e.kind |> _assert_eq "pipeline "
