<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"inl year_of (e : page.entry) : string = sm'.slice 0i32 3i32 e.date\n\ninl entry_row (e : page.entry) : string =\n    \"<li class=\\\"post\\\"><time>\" ++# html.escape e.date ++# \"</time>\"\n    ++# \"<span class=\\\"kind\\\">\" ++# page.kind_label e.kind ++# \"</span>\"\n    ++# \"<a href=\\\"/\" ++# html.escape e.slug ++# \"/\\\">\" ++# html.escape e.title ++# \"</a>\"\n    ++# \"<p>\" ++# html.escape e.blurb ++# \"</p></li>\"\n\ninl rec rows (current : string) (entries : list page.entry) : string =\n    match entries with\n    | Nil => if current = \"\" then \"\" else \"</ul>\"\n    | Cons (e, rest) =>\n        inl year = year_of e\n        if year = current then entry_row e ++# rows current rest\n        else\n            inl close = if current = \"\" then \"\" else \"</ul>\"\n            close ++# \"<h2 class=\\\"year\\\">\" ++# year ++# \"</h2><ul>\" ++# entry_row e ++# rows year rest\n\ninl featured (entries : list page.entry) : string =\n    match entries with\n    | Nil => \"\"\n    | Cons (e, _) => \"<section class=\\\"featured\\\"><span class=\\\"badge\\\">Latest</span>\" ++# entry_row e ++# \"</section>\"\n\ninl rec only (kind : page.kind) (entries : list page.entry) : list page.entry =\n    match entries with\n    | Nil => Nil\n    | Cons (e, rest) => if e.kind = kind then Cons (e, only kind rest) else only kind rest\n\ninl render_index (entries : list page.entry) : string =\n    (\n        \"<nav class=\\\"tabs\\\"><a href=\\\"/\\\">Everything</a><a href=\\\"/articles/\\\">Articles</a><a \"\n        ^^ \"href=\\\"/releases/\\\">Releases</a></nav>\"\n    )\n    ++# featured entries\n    ++# rows \"\" entries","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  inl year_of (e : page.entry) : string = sm'.slice 0i32 3i32 e.date

  inl entry_row (e : page.entry) : string =
      "<li class=\"post\"><time>" ++# html.escape e.date ++# "</time>"
      ++# "<span class=\"kind\">" ++# page.kind_label e.kind ++# "</span>"
      ++# "<a href=\"/" ++# html.escape e.slug ++# "/\">" ++# html.escape e.title ++# "</a>"
      ++# "<p>" ++# html.escape e.blurb ++# "</p></li>"

  inl rec rows (current : string) (entries : list page.entry) : string =
      match entries with
      | Nil => if current = "" then "" else "</ul>"
      | Cons (e, rest) =>
          inl year = year_of e
          if year = current then entry_row e ++# rows current rest
          else
              inl close = if current = "" then "" else "</ul>"
              close ++# "<h2 class=\"year\">" ++# year ++# "</h2><ul>" ++# entry_row e ++# rows year rest

  inl featured (entries : list page.entry) : string =
      match entries with
      | Nil => ""
      | Cons (e, _) => "<section class=\"featured\"><span class=\"badge\">Latest</span>" ++# entry_row e ++# "</section>"

  inl rec only (kind : page.kind) (entries : list page.entry) : list page.entry =
      match entries with
      | Nil => Nil
      | Cons (e, rest) => if e.kind = kind then Cons (e, only kind rest) else only kind rest

  inl render_index (entries : list page.entry) : string =
      (
          "<nav class=\"tabs\"><a href=\"/\">Everything</a><a href=\"/articles/\">Articles</a><a "
          ^^ "href=\"/releases/\">Releases</a></nav>"
      )
      ++# featured entries
      ++# rows "" entries
  """,
  timeout: 300_000
)
```

#### the_year_comes_from_the_date (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nyear_of (page.sample ()) |> _assert_eq \"2026\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test

  year_of (page.sample ()) |> _assert_eq "2026"
  """,
  timeout: 300_000
)
```

#### the_index_features_the_latest_post (test)

