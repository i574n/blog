<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= year_of (e : page.entry) : string = sm'.slice 0i32 3i32 e.date\n\n:= entry_row (e : page.entry) : string =\n    \"<li class=\\\"post\\\"><time>\" ++# html.escape e.date ++# \"</time>\"\n    ++# \"<span class=\\\"kind\\\">\" ++# page.kind_label e.kind ++# \"</span>\"\n    ++# \"<a href=\\\"/\" ++# html.escape e.slug ++# \"/\\\">\" ++# html.escape e.title ++# \"</a>\"\n    ++# \"<p>\" ++# html.escape e.blurb ++# \"</p></li>\"\n\n:= ^ rows (current : string) (entries : list page.entry) : string =\n    ?= entries ?|\n    | [] => ? current = \"\" ?> \"\" |: \"</ul>\"\n    | e :: rest =>\n        := year = year_of e\n        ? year = current ?> entry_row e ++# rows current rest\n        |:\n            := close = ? current = \"\" ?> \"\" |: \"</ul>\"\n            close ++# \"<h2 class=\\\"year\\\">\" ++# year ++# \"</h2><ul>\" ++# entry_row e ++# rows year rest\n\n:= featured (entries : list page.entry) : string =\n    ?= entries ?|\n    | [] => \"\"\n    | e :: _ => \"<section class=\\\"featured\\\"><span class=\\\"badge\\\">Latest</span>\" ++# entry_row e ++# \"</section>\"\n\n:= ^ only (kind : page.kind) (entries : list page.entry) : list page.entry =\n    ?= entries ?|\n    | [] => []\n    | e :: rest => ? e.kind = kind ?> e :: only kind rest |: only kind rest\n\n:= render_index (entries : list page.entry) : string =\n    (\n        \"<nav class=\\\"tabs\\\"><a href=\\\"/\\\">Everything</a><a href=\\\"/articles/\\\">Articles</a><a \"\n        ^^ \"href=\\\"/releases/\\\">Releases</a></nav>\"\n    )\n    ++# featured entries\n    ++# rows \"\" entries","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := year_of (e : page.entry) : string = sm'.slice 0i32 3i32 e.date

  := entry_row (e : page.entry) : string =
      "<li class=\"post\"><time>" ++# html.escape e.date ++# "</time>"
      ++# "<span class=\"kind\">" ++# page.kind_label e.kind ++# "</span>"
      ++# "<a href=\"/" ++# html.escape e.slug ++# "/\">" ++# html.escape e.title ++# "</a>"
      ++# "<p>" ++# html.escape e.blurb ++# "</p></li>"

  := ^ rows (current : string) (entries : list page.entry) : string =
      ?= entries ?|
      | [] => ? current = "" ?> "" |: "</ul>"
      | e :: rest =>
          := year = year_of e
          ? year = current ?> entry_row e ++# rows current rest
          |:
              := close = ? current = "" ?> "" |: "</ul>"
              close ++# "<h2 class=\"year\">" ++# year ++# "</h2><ul>" ++# entry_row e ++# rows year rest

  := featured (entries : list page.entry) : string =
      ?= entries ?|
      | [] => ""
      | e :: _ => "<section class=\"featured\"><span class=\"badge\">Latest</span>" ++# entry_row e ++# "</section>"

  := ^ only (kind : page.kind) (entries : list page.entry) : list page.entry =
      ?= entries ?|
      | [] => []
      | e :: rest => ? e.kind = kind ?> e :: only kind rest |: only kind rest

  := render_index (entries : list page.entry) : string =
      (
          "<nav class=\"tabs\"><a href=\"/\">Everything</a><a href=\"/articles/\">Articles</a><a "
          ^^ "href=\"/releases/\">Releases</a></nav>"
      )
      ++# featured entries
      ++# rows "" entries
  """,
  timeout: 300_000
)
```

#### the_year_comes_from_the_date (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nyear_of (page.sample ()) |> _assert_eq \"2026\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test

  year_of (page.sample ()) |> _assert_eq "2026"
  """,
  timeout: 300_000
)
```

