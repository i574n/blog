<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= year_of (e : page.entry) : string = sm'.slice 0i32 3i32 e.date\n\n:= entry_row (root : string) (e : page.entry) : string =\n    \"<li class=\\\"post\\\"><time>\" ++# html.escape e.date ++# \"</time>\"\n    ++# \"<span class=\\\"kind\\\">\" ++# page.kind_label e.kind ++# \"</span>\"\n    ++# \"<a href=\\\"\" ++# root ++# html.escape e.slug ++# \"/\\\">\" ++# html.escape e.title ++# \"</a>\"\n    ++# \"<p>\" ++# html.escape e.blurb ++# \"</p></li>\"\n\n:= ^ rows (root : string) (current : string) (entries : list page.entry) : string =\n    ?= entries ?|\n    | [] => ? current = \"\" ?> \"\" |: \"</ul>\"\n    | e :: rest =>\n        := year = year_of e\n        ? year = current ?> entry_row root e ++# rows root current rest\n        |:\n            := close = ? current = \"\" ?> \"\" |: \"</ul>\"\n            close ++# \"<h2 class=\\\"year\\\">\" ++# year ++# \"</h2><ul>\" ++# entry_row root e ++# rows root year rest\n\n:= featured (root : string) (entries : list page.entry) : string =\n    ?= entries ?|\n    | [] => \"\"\n    | e :: _ => \"<section class=\\\"featured\\\"><span class=\\\"badge\\\">Latest</span>\" ++# entry_row root e ++# \"</section>\"\n\n:= ^ only (kind : page.kind) (entries : list page.entry) : list page.entry =\n    ?= entries ?|\n    | [] => []\n    | e :: rest => ? e.kind = kind ?> e :: only kind rest |: only kind rest\n\n:= render_index (root : string) (entries : list page.entry) : string =\n    \"<nav class=\\\"tabs\\\"><a href=\\\"\" ++# root ++# \"\\\">Everything</a>\"\n    ++# \"<a href=\\\"\" ++# root ++# \"articles/\\\">Articles</a>\"\n    ++# \"<a href=\\\"\" ++# root ++# \"releases/\\\">Releases</a></nav>\"\n    ++# featured root entries\n    ++# rows root \"\" entries","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := year_of (e : page.entry) : string = sm'.slice 0i32 3i32 e.date

  := entry_row (root : string) (e : page.entry) : string =
      "<li class=\"post\"><time>" ++# html.escape e.date ++# "</time>"
      ++# "<span class=\"kind\">" ++# page.kind_label e.kind ++# "</span>"
      ++# "<a href=\"" ++# root ++# html.escape e.slug ++# "/\">" ++# html.escape e.title ++# "</a>"
      ++# "<p>" ++# html.escape e.blurb ++# "</p></li>"

  := ^ rows (root : string) (current : string) (entries : list page.entry) : string =
      ?= entries ?|
      | [] => ? current = "" ?> "" |: "</ul>"
      | e :: rest =>
          := year = year_of e
          ? year = current ?> entry_row root e ++# rows root current rest
          |:
              := close = ? current = "" ?> "" |: "</ul>"
              close ++# "<h2 class=\"year\">" ++# year ++# "</h2><ul>" ++# entry_row root e ++# rows root year rest

  := featured (root : string) (entries : list page.entry) : string =
      ?= entries ?|
      | [] => ""
      | e :: _ => "<section class=\"featured\"><span class=\"badge\">Latest</span>" ++# entry_row root e ++# "</section>"

  := ^ only (kind : page.kind) (entries : list page.entry) : list page.entry =
      ?= entries ?|
      | [] => []
      | e :: rest => ? e.kind = kind ?> e :: only kind rest |: only kind rest

  := render_index (root : string) (entries : list page.entry) : string =
      "<nav class=\"tabs\"><a href=\"" ++# root ++# "\">Everything</a>"
      ++# "<a href=\"" ++# root ++# "articles/\">Articles</a>"
      ++# "<a href=\"" ++# root ++# "releases/\">Releases</a></nav>"
      ++# featured root entries
      ++# rows root "" entries
  """,
  timeout: 300_000
)
```

#### the_year_comes_from_the_date (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n\nyear_of (page.sample ()) |> _assert_eq \"2026\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol

  year_of (page.sample ()) |> _assert_eq "2026"
  """,
  timeout: 300_000
)
```

